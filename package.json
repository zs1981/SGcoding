{
    "name": "sgcoding",
    "version": "0.0.3",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "sgcoding": "./dist/index.js"
    },
    "scripts": {
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "build": "tsc && node scripts/copy-prompts.mjs",
        "dev": "tsx src/index.ts",
        "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
        "db:migrate": "npm run build && node dist/database/migrate.js"
    },
    "dependencies": {
        "@ai-sdk/openai": "^4.0.67",
        "ai": "^7.0.102",
        "better-sqlite3": "^12.11.1",
        "commander": "^15.0.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "openai": "^6.45.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^26.1.1",
        "drizzle-kit": "^0.31.10",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "@esbuild-kit/core-utils": {
            "esbuild": "0.25.12"
        }
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "better-sqlite3@12.11.1": true,
        "esbuild@0.28.2": true
    }
}
