{
    "name": "sgcoding",
    "version": "0.0.3",
    "type": "module",
    "main": "dist/tui/index.js",
    "bin": {
        "sgcoding": "./dist/tui/index.js"
    },
    "files": [
        "dist/",
        "drizzle/",
        "provider.yaml"
    ],
    "scripts": {
        "start": "node dist/tui/index.js",
        "typecheck": "tsc --noEmit",
        "test:chat": "npm run build && node tests/chat-mode.test.mjs",
        "rag:eval": "node --import tsx scripts/eval-rag.mjs",
        "build": "node scripts/clean-dist.mjs && tsc && node scripts/copy-prompts.mjs",
        "prepack": "npm run build",
        "dev": "tsx src/tui/index.tsx",
        "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
        "db:migrate": "npm run build && node dist/database/migrate.js"
    },
    "dependencies": {
        "@ai-sdk/openai": "^4.0.67",
        "@babel/parser": "^7.29.15",
        "ai": "^7.0.102",
        "better-sqlite3": "^12.11.1",
        "commander": "^15.0.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "effect": "4.0.0-beta.74",
        "ink": "^8.0.0",
        "ink-text-input": "^6.0.0",
        "openai": "^6.45.0",
        "react": "^19.3.1",
        "yaml": "^2.9.1",
        "yargs": "18.0.0"
    },
    "devDependencies": {
        "@babel/types": "^7.29.15",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^26.1.1",
        "@types/react": "^19.3.0",
        "@types/yargs": "17.0.33",
        "drizzle-kit": "^0.31.10",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "@esbuild-kit/core-utils": {
            "esbuild": "0.25.12"
        }
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "better-sqlite3@12.11.1": true,
        "esbuild@0.28.2": true
    }
}
